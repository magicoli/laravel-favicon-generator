{
    "name": "magicoli/laravel-favicon-generator",
    "description": "Package to generate favicons within your Laravel application. (Oli's fork)",
    "keywords": [
        "Blockpoint",
        "laravel",
        "laravel-favicon-generator"
    ],
    "homepage": "https://github.com/magicoli/laravel-favicon-generator",
    "license": "MIT",
    "authors": [
        {
            "name": "Blockpoint",
            "email": "info@blockpoint.nl",
            "role": "Developer"
        },
        {
            "name": "Olivier van Helden",
            "homepage": "https://magiiic.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "intervention/image": "^3.0||^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Blockpoint\\LaravelFaviconGenerator\\": "src/",
            "Blockpoint\\LaravelFaviconGenerator\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blockpoint\\LaravelFaviconGenerator\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blockpoint\\LaravelFaviconGenerator\\LaravelFaviconGeneratorServiceProvider"
            ],
            "aliases": {
                "LaravelFaviconGenerator": "Blockpoint\\LaravelFaviconGenerator\\Facades\\LaravelFaviconGenerator"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
